# Git commit monitor (runs every 5 minutes before prompt)
_git_commit_monitor() {
  local now last
  now=$(date +%s)
  last=$(cat ~/.git-commit-last-check 2>/dev/null || echo 0)

  if ((now - last >= 300)); then
    echo "$now" >~/.git-commit-last-check
    ~/dev/scripts/git-commit-check 2>/dev/null
  fi
}

PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}_git_commit_monitor"
